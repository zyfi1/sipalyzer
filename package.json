{
  "name": "sipalyzer",
  "version": "1.0.0-beta.1",
  "description": "SIPalyzer - Professional VoIP toolset for registration testing and diagnostics",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "typecheck": "tsc --noEmit",
    "lint": "npm run typecheck",
    "test": "vitest run",
    "check:frontend": "npm run typecheck && npm run test && npm run build",
    "rust:fmt:check": "cargo fmt --manifest-path src-tauri/crates/sipalyzer-core/Cargo.toml -- --check",
    "rust:clippy": "cargo clippy --manifest-path src-tauri/crates/sipalyzer-core/Cargo.toml --all-targets -- -D warnings",
    "rust:test": "cargo test --manifest-path src-tauri/crates/sipalyzer-core/Cargo.toml --locked",
    "rust:fmt:check:app": "cargo fmt --manifest-path src-tauri/Cargo.toml -- --check",
    "rust:clippy:app": "cargo clippy --manifest-path src-tauri/Cargo.toml --all-targets -- -D warnings",
    "rust:test:app": "cargo test --manifest-path src-tauri/Cargo.toml --locked",
    "check:rust": "npm run rust:fmt:check && npm run rust:clippy && npm run rust:test",
    "check:rust:app": "npm run rust:fmt:check:app && npm run rust:clippy:app && npm run rust:test:app",
    "hygiene": "npm run check:frontend && npm run check:rust",
    "hygiene:unused:knip": "npx --yes knip",
    "hygiene:unused:ts-prune": "npx --yes ts-prune",
    "test:troubleshooting": "vitest run src/lib/troubleshootingEngine.guardrails.test.ts",
    "preview": "vite preview",
    "tauri": "tauri",
    "tauri:dev": "node ./scripts/run-tauri-dev-stable.mjs",
    "tauri:dev:no-watch": "npm run build && tauri dev --no-watch",
    "tauri:dev:watch": "node ./scripts/run-tauri-dev-stable.mjs",
    "tauri:run": "npm run build && tauri build",
    "test:packet-fidelity": "node ./scripts/run-packet-fidelity-checks.mjs",
    "setup:go-toolchain": "node ./scripts/setup-go-toolchain.mjs",
    "validate:native-artifacts": "node ./scripts/validate-native-artifacts.mjs",
    "validate:native-artifacts:strict": "node ./scripts/validate-native-artifacts.mjs --strict",
    "stage:native-artifacts": "node ./scripts/stage-native-artifacts.mjs",
    "hydrate:native-artifacts": "node ./scripts/hydrate-native-artifacts.mjs",
    "fetch:native-artifacts": "node ./scripts/fetch-native-artifacts.mjs",
    "fetch:native-artifacts:upstream": "node ./scripts/fetch-native-artifacts-upstream.mjs"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/modifiers": "^9.0.0",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@hookform/resolvers": "^5.2.2",
    "@iconify-json/meteocons": "^1.2.4",
    "@iconify/react": "^6.0.2",
    "@monaco-editor/react": "^4.7.0",
    "@tanstack/react-query": "^5.90.20",
    "@tanstack/react-table": "^8.21.3",
    "@tanstack/react-virtual": "^3.13.18",
    "@tauri-apps/api": "~2.9.1",
    "@tauri-apps/plugin-dialog": "^2.6.0",
    "@tippyjs/react": "^4.2.6",
    "@tiptap/extension-code-block-lowlight": "^3.19.0",
    "@tiptap/extension-highlight": "^3.19.0",
    "@tiptap/extension-image": "^3.19.0",
    "@tiptap/extension-link": "^3.19.0",
    "@tiptap/extension-placeholder": "^3.19.0",
    "@tiptap/extension-table": "^3.19.0",
    "@tiptap/extension-table-cell": "^3.19.0",
    "@tiptap/extension-table-header": "^3.19.0",
    "@tiptap/extension-table-row": "^3.19.0",
    "@tiptap/extension-task-item": "^3.19.0",
    "@tiptap/extension-task-list": "^3.19.0",
    "@tiptap/extension-typography": "^3.19.0",
    "@tiptap/markdown": "^3.17.1",
    "@tiptap/react": "^3.19.0",
    "@tiptap/starter-kit": "^3.19.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/xterm": "^6.0.0",
    "@xyflow/react": "^12.10.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.0",
    "cmdk": "^1.1.1",
    "d3": "^7.9.0",
    "dagre": "^0.8.5",
    "date-fns": "^3.0.0",
    "framer-motion": "^12.34.3",
    "fuse.js": "^7.1.0",
    "lowlight": "^3.3.0",
    "lucide-react": "^0.577.0",
    "marked": "^17.0.1",
    "monaco-editor": "^0.55.1",
    "next-themes": "^0.4.6",
    "pigeon-maps": "^0.22.1",
    "radix-ui": "^1.4.3",
    "react": "^18.3.1",
    "react-day-picker": "^9.14.0",
    "react-dom": "^18.3.1",
    "react-grid-layout": "^2.2.2",
    "react-hook-form": "^7.71.2",
    "react-is": "^19.2.4",
    "react-markdown": "^10.1.0",
    "react-syntax-highlighter": "^16.1.0",
    "recharts": "^3.7.0",
    "remark-gfm": "^4.0.1",
    "sonner": "^2.0.7",
    "suncalc": "^1.9.0",
    "tailwind-merge": "^2.2.0",
    "turndown": "^7.2.2",
    "zod": "^4.3.6",
    "zustand": "^4.4.7"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@tauri-apps/cli": "^2.9.0",
    "@types/dagre": "^0.7.54",
    "@types/marked": "^5.0.2",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@types/react-split-pane": "^0.1.10",
    "@types/react-syntax-highlighter": "^15.5.13",
    "@types/suncalc": "^1.9.2",
    "@types/turndown": "^5.0.6",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.16",
    "postcss": "^8.4.32",
    "sharp": "^0.34.5",
    "tailwindcss": "^4.0.0",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.3",
    "vite": "^6.0.0",
    "vitest": "^4.0.18"
  }
}
